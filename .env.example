# Copy to .env and adjust. Read by docker compose (variable substitution and `env_file`)
# and by the server (TCG_* variables).
# Only the first section is mandatory. Everything else is commented out and shows the
# default value: uncomment a line to change it.

# =====================================================================================
# Mandatory
# =====================================================================================

# PostgreSQL password, used by the `db` service and in the server's database URL.
POSTGRES_PASSWORD=change-me

# Signs session tokens. At least 32 random characters (the server refuses to start
# otherwise). Changing it signs everybody out. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TCG_SECRET_KEY=change-me

# =====================================================================================
# Docker compose
# =====================================================================================

# Host port the web UI and API are published on.
# ZUKAN_PORT=8000

# Image tag pulled by docker-compose.yml: latest, a version (0.1.0) or a dev build
# (dev-<branch>). Ignored by docker-compose-dev.yml, which builds from the checkout.
# ZUKAN_TAG=latest

# MTU of the containers' network. Below 1500 so the server also works when the host goes
# through a VPN tunnel. Lower it for tunnels with less room; the network is
# recreated on `docker compose down && docker compose up -d`.
# TCG_NETWORK_MTU=1420

# =====================================================================================
# Web access and sessions
# =====================================================================================

# Public URL where the site is reached. SSO redirect URIs
# (<url>/api/auth/oidc/<provider>/callback) and the SSO logout return address derive
# from it: set it when SSO is enabled.
# TCG_PUBLIC_URL=http://localhost:5173

# Session cookies are only sent over HTTPS. Set to false when the web UI is served over
# plain HTTP (local testing, LAN without TLS), otherwise web sign-in does not stick.
# The Android app uses tokens and is not affected.
# TCG_COOKIE_SECURE=true

# Lifetime of access tokens (seconds) and of refresh tokens, i.e. how long a session
# stays signed in without activity (seconds).
# TCG_ACCESS_TOKEN_TTL_SECONDS=3600
# TCG_REFRESH_TOKEN_TTL_SECONDS=7776000

# Reverse proxies (comma-separated addresses or networks, * for any) whose
# X-Forwarded-For / X-Forwarded-Proto headers are trusted. Set it to your proxy's address
# as the container sees it (often the Docker network gateway, e.g. 172.18.0.1) when Zukan
# runs behind one, so sign-in limits count real client addresses. Others cannot fake them.
# TCG_FORWARDED_ALLOW_IPS=127.0.0.1

# Sign-in limits (0: none). Failed password sign-ins allowed per account name and per
# client address within the window (seconds), then refresh and SSO requests per address
# and minute. Past them the API answers 429 with Retry-After; counters reset on restart.
# TCG_LOGIN_MAX_FAILURES=10
# TCG_LOGIN_IP_MAX_FAILURES=50
# TCG_LOGIN_WINDOW_SECONDS=900
# TCG_AUTH_REQUESTS_PER_MINUTE=60

# Largest request accepted (bytes); CSV imports are up to 5 MB.
# TCG_MAX_REQUEST_BYTES=6291456

# =====================================================================================
# Accounts
# =====================================================================================

# Administrator created on start while the database has no user, so the first sign-in
# works. Change the password after signing in. Empty password: not created.
# TCG_DEFAULT_ADMIN_USERNAME=admin
# TCG_DEFAULT_ADMIN_PASSWORD=changeme

# Username/password sign-in. Turn off once SSO works, keeping an administrator able to
# sign in through SSO (recovery: set back to true and run `zukan create-admin`).
# TCG_LOCAL_LOGIN_ENABLED=true

# Password for `zukan create-admin NAME` (create or reset an administrator) without
# the interactive prompt. Pass it on the command line rather than keeping it here:
#   docker compose exec -e TCG_ADMIN_PASSWORD=... api zukan create-admin NAME
# TCG_ADMIN_PASSWORD=


# =====================================================================================
# Single sign-on (OpenID Connect), see docs/sso.md
# =====================================================================================

# SSO providers, as a JSON list of names (lowercase letters, digits, - and _). A name
# appears in URLs (/api/auth/oidc/<name>/callback). Empty: no SSO button.
# TCG_OIDC_PROVIDERS=["home"]
# Each provider is then configured by TCG_OIDC_<NAME>_* variables, <NAME> being the
# name in uppercase with - replaced by _. Example for "home":
#
# Login button label (default: the name).
# TCG_OIDC_HOME_DISPLAY_NAME=Home SSO
# Issuer URL (mandatory), discovered through <issuer>/.well-known/openid-configuration.
# TCG_OIDC_HOME_ISSUER=https://sso.example.com/realms/home
# Confidential client used by the web UI (mandatory) and its secret.
# TCG_OIDC_HOME_CLIENT_ID=tcg-web
# TCG_OIDC_HOME_CLIENT_SECRET=change-me
# Public client (PKCE) used by the Android app. Unset: no SSO in the app.
# TCG_OIDC_HOME_MOBILE_CLIENT_ID=tcg-android
# Requested scopes, JSON list. Authelia also needs "groups".
# TCG_OIDC_HOME_SCOPES=["openid","profile","email"]
# Claims holding the username and the groups.
# TCG_OIDC_HOME_USERNAME_CLAIM=preferred_username
# TCG_OIDC_HOME_GROUPS_CLAIM=groups
# Members of these groups are administrators, others users, synced on each SSO login.
# Empty: roles are managed in Zukan.
# TCG_OIDC_HOME_ADMIN_GROUPS=[]
# Only members of these groups may sign in. Empty: everybody the IdP accepts.
# TCG_OIDC_HOME_ALLOWED_GROUPS=[]
# Create an account on first SSO sign-in. Off: only accounts linked from settings.
# TCG_OIDC_HOME_AUTO_CREATE_USERS=true

# =====================================================================================
# Worker (catalog, price and image refreshes)
# =====================================================================================

# Hours between catalog refreshes (large downloads, new sets are rare). After an upgrade
# that changes how a game's catalog is stored, that catalog is refreshed at once.
# TCG_CATALOG_INTERVAL_HOURS=168
# Hours between price and owned card image refreshes.
# TCG_SYNC_INTERVAL_HOURS=24
# Hours between refreshes of outdated cards (missed by the last catalog refresh, or with
# missing image or details), fetched again one by one. Opening such a card in the web UI
# also fetches it again (at most once an hour).
# TCG_REFRESH_INTERVAL_HOURS=48
# Games to refresh, as a JSON list (e.g. ["mtg","sorcery"]). Empty: every installed game.
# TCG_WORKER_GAMES=[]
# User-Agent sent to card data APIs and SSO providers. Default: Zukan/<server version>.
# TCG_USER_AGENT=Zukan/0.15.0

# =====================================================================================
# Games
# =====================================================================================

# MTG catalog: all_cards (~400 MB download, translated names needed to scan non-English
# cards) or default_cards (~80 MB, English names only).
# TCG_MTG_CATALOG_BULK=all_cards

# Pokémon languages imported from TCGdex. Asian sets add ~40k cards fetched one by one.
# A set listed in several languages is fetched in full once (English, else Japanese,
# Traditional Chinese, Thai, Indonesian); the others add names and images. Keep "en" to
# attach Asian printings to the English card of the same Pokémon. TCGdex also has "ko"
# and "zh-cn", nearly empty: Korean and Simplified Chinese come from the datasets below.
# TCG_POKEMON_LANGUAGES=["en","fr","de","it","es","pt","ja","zh-tw","th","id"]
# Korean cards from github.com/type-null/PTCG-database (~33 MB per catalog sync) and
# mainland China (Simplified Chinese) cards from github.com/duanxr/PTCG-CHS-Datasets
# (~10 MB; non-commercial use only). false skips them.
# TCG_POKEMON_KOREAN=true
# TCG_POKEMON_CHINESE=true

# Yu-Gi-Oh! name languages. English, French, German, Italian and Portuguese names come
# from YGOPRODeck; Spanish, Japanese, Korean and Chinese ones from YGOJSON (~57 MB per
# catalog sync), which also adds the Japanese, Korean and Chinese (OCG) sets of those
# languages (~85k printings). Leave the Asian languages out to skip their sets.
# TCG_YUGIOH_LANGUAGES=["en","fr","de","it","pt","es","ja","ko","zh-hans","zh-hant"]
# Pages of the official Konami card database read a day (one a second) for the Japanese
# and Korean names and printings of cards newer than YGOJSON. Each card is read once
# (kept under TCG_IMAGE_DIR/cache). 0: never.
# TCG_YUGIOH_KONAMI_DAILY_REQUESTS=300

# Disney Lorcana: LorcanaJSON (English, French, German, Italian), no setting.

# =====================================================================================
# API keys
# =====================================================================================

# Tokens of external APIs (card data, prices) that need one. Names follow
#   TCG_APITOKEN_<SOURCE TYPE>_[<CATEGORY>_]<API NAME>
# with SOURCE TYPE GAMES (card data) or PRICES (markets), CATEGORY the game for game
# sources (MTG, PKM, SOR, RFB, YGO, LOR), none for sources covering several games, e.g.
# TCG_APITOKEN_GAMES_MTG_SCRYFALL, TCG_APITOKEN_PRICES_CARDNEXUS. Scryfall, MTGJSON,
# TCGdex, Sorcery, Riftcodex, Riot's card gallery, YGOPRODeck,
# YGOJSON, the Konami database, LorcanaJSON, tcgcsv and Cardmarket files need no key. Without a key, the sources below are skipped.
#
# Riftbound: Riot's content API (official). Needs a key Riot approved for a Riftbound
# product (developer.riotgames.com); development keys are refused. Without one, the
# Riftbound catalog comes from Riftcodex (riftcodex.com). How to get one: docs/riftbound.md.
# TCG_APITOKEN_GAMES_RFB_RIOT=
# Card databases filling what each game's own sources miss (pictures, rarities, artists,
# TCGplayer ids), only for sets with gaps:
# - tcg-api.eu (Pokémon, Magic, Lorcana; 10 000 requests a day on the free tier)
# TCG_APITOKEN_GAMES_TCGAPIEU=
# TCG_TCGAPI_EU_DAILY_REQUESTS=9000
# - apitcg.com (Magic, Pokémon, Riftbound, Yu-Gi-Oh!, Lorcana; 1000 requests a month on
#   the free tier: it runs after every other source and skips sets it found nothing for,
#   30 days)
# TCG_APITOKEN_GAMES_APITCG=
# TCG_APITCG_MONTHLY_REQUESTS=900

# =====================================================================================
# Set by the compose files and the image: only for running the server outside Docker
# =====================================================================================

# Database (compose builds it from POSTGRES_PASSWORD).
# TCG_DATABASE_URL=postgresql+asyncpg://tcg:tcg@localhost:5432/tcg
# Built web UI, card image cache, and folder card images are imported from
# (image: /app/web, /data/images, /data/import). The image folder holds one folder per
# game: cards/, sets/, symbols/ and rarity/ (own pictograms there replace Zukan's, see
# README "Image folders").
# TCG_WEB_DIR=../web/dist
# TCG_IMAGE_DIR=data/images
# TCG_IMPORT_DIR=data/import
