# Copy to .env and adjust. Used by docker compose.
POSTGRES_PASSWORD=change-me
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TCG_SECRET_KEY=change-me
# Public URL where the site is reached (OIDC redirect URIs derive from it).
TCG_PUBLIC_URL=http://localhost:8000
# Set to false only when serving over plain HTTP (local testing).
TCG_COOKIE_SECURE=true

# SSO client secrets referenced from auth.yaml as ${VAR}
OIDC_HOME_SECRET=

# Worker: hours between catalog refreshes, hours between price/image refreshes,
# games to refresh (JSON list, empty = all)
TCG_CATALOG_INTERVAL_HOURS=168
TCG_SYNC_INTERVAL_HOURS=24
# TCG_WORKER_GAMES=["sorcery"]

# MTG catalog: all_cards (~400 MB download, translated names for scanning) or
# default_cards (~80 MB, English names only)
# TCG_MTG_CATALOG_BULK=all_cards
# Pokémon languages imported from TCGdex. Asian sets add ~40k cards fetched one by one.
# TCG_POKEMON_LANGUAGES=["en","fr","de","it","es","pt","ja","ko","zh-cn","zh-tw"]
