# Copy to .env and adjust. Read by docker compose (variable substitution and `env_file`)
# and by the server (TCG_* variables).
# Only the first section is mandatory. Everything else is commented out and shows the
# default value: uncomment a line to change it.

# =====================================================================================
# Mandatory
# =====================================================================================

# PostgreSQL password of the database owner (`tcg`, a superuser), used by the `db`
# service and by the `migrate` service only.
POSTGRES_PASSWORD=change-me

# Password of `zukan_app`, the database role of the API and worker (no superuser, only
# reads and writes data). The `migrate` service creates it and sets this password on
# every start (`zukan db-roles`). Use URL-safe characters (it goes in a database URL):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TCG_DB_APP_PASSWORD=change-me

# Signs session tokens. At least 32 random characters (the server refuses to start
# otherwise). Changing it signs everybody out. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TCG_SECRET_KEY=change-me

# =====================================================================================
# Docker compose
# =====================================================================================

# Host port the web UI and API are published on, and the host address it listens on.
# 127.0.0.1: only this machine (a reverse proxy such as Caddy running on the host).
# 0.0.0.0: every address, e.g. a proxy on another machine or no proxy on a LAN; then
# filter the port with a firewall (Docker's published ports bypass UFW).
# ZUKAN_PORT=8000
# ZUKAN_BIND=127.0.0.1

# Image tag pulled by docker-compose.yml: latest, a version (0.1.0) or a dev build
# (dev-<branch>). Ignored by docker-compose-dev.yml, which builds from the checkout.
# ZUKAN_TAG=latest

# MTU of the containers' network. Below 1500 so the server also works when the host goes
# through a VPN tunnel. Lower it for tunnels with less room; the network is
# recreated on `docker compose down && docker compose up -d`.
# TCG_NETWORK_MTU=1420

# =====================================================================================
# Web access and sessions
# =====================================================================================

# Public URL where the site is reached. SSO redirect URIs
# (<url>/api/auth/oidc/<provider>/callback) and the SSO logout return address derive
# from it: set it when SSO is enabled.
# TCG_PUBLIC_URL=http://localhost:5173

# Session cookies are only sent over HTTPS. Set to false when the web UI is served over
# plain HTTP (local testing, LAN without TLS), otherwise web sign-in does not stick.
# The Android app uses tokens and is not affected.
# TCG_COOKIE_SECURE=true

# Lifetime of access tokens (seconds) and of refresh tokens, i.e. how long a session
# stays signed in without activity (seconds).
# TCG_ACCESS_TOKEN_TTL_SECONDS=3600
# TCG_REFRESH_TOKEN_TTL_SECONDS=7776000

# SSO sessions end this long after the sign-in (seconds), whatever the activity: the user
# signs in at the identity provider again (default 30 days).
# TCG_SSO_SESSION_MAX_AGE_SECONDS=2592000
# Web SSO sessions ask the identity provider this often (seconds, on a session refresh)
# whether the account is still allowed, with the provider's refresh token: deactivated
# or removed from the allowed groups = signed out; groups and administrator role synced
# again. Needs a refresh token from the provider (Authentik: add the offline_access scope
# to TCG_OIDC_<NAME>_SCOPES and to the provider's scopes). 0: never.
# TCG_SSO_RECHECK_SECONDS=900

# Content-Security-Policy of the web UI: enforce (default), report (only reported in the
# browser console, Report-Only header) or off (only the no-framing rule).
# TCG_CSP_MODE=enforce

# Reverse proxies (comma-separated addresses or networks, * for any) whose
# X-Forwarded-For / X-Forwarded-Proto headers are trusted. Set it to your proxy's address
# as the container sees it (often the Docker network gateway, e.g. 172.18.0.1) when Zukan
# runs behind one, so sign-in limits count real client addresses. Others cannot fake them.
# TCG_FORWARDED_ALLOW_IPS=127.0.0.1

# Sign-in limits (0: none). Failed password sign-ins allowed per account name and per
# client address within the window (seconds), then refresh and SSO requests per address
# and minute. Past them the API answers 429 with Retry-After; counters reset on restart.
# TCG_LOGIN_MAX_FAILURES=10
# TCG_LOGIN_IP_MAX_FAILURES=50
# TCG_LOGIN_WINDOW_SECONDS=900
# TCG_AUTH_REQUESTS_PER_MINUTE=60

# Largest request accepted (bytes); imports (CSV or zip export) are up to 5 MB.
# TCG_MAX_REQUEST_BYTES=6291456

# =====================================================================================
# Accounts
# =====================================================================================

# Administrator created on start while the database has no user and local login is on,
# so the first sign-in works. Without a password here, a random one is written to
# TCG_ADMIN_PASSWORD_FILE (compose: ./data/init/initial-admin-password, readable only by the
# server's user and root), never to the log. Sign in and change it: the file is deleted.
# TCG_DEFAULT_ADMIN_USERNAME=admin
# TCG_DEFAULT_ADMIN_PASSWORD=
# TCG_ADMIN_PASSWORD_FILE=/data/init/initial-admin-password

# Username/password sign-in. Turn off once SSO works, keeping an administrator able to
# sign in through SSO (recovery: set back to true and run `zukan create-admin`). With it
# off and one SSO provider, the login page goes straight to the provider.
# Local and SSO accounts are separate: an SSO login never joins a local account. With it
# off, administrators cannot create local accounts (SSO accounts are created at first
# sign-in).
# TCG_LOCAL_LOGIN_ENABLED=true

# Password for `zukan create-admin NAME` (create or reset an administrator) without
# the interactive prompt. Pass it on the command line rather than keeping it here:
#   docker compose exec -e TCG_ADMIN_PASSWORD=... api zukan create-admin NAME
# TCG_ADMIN_PASSWORD=


# =====================================================================================
# Single sign-on (OpenID Connect), see https://github.com/FoxOps/zukan/wiki/Single-sign-on
# =====================================================================================

# SSO providers, as a JSON list of names (lowercase letters, digits, - and _). A name
# appears in URLs (/api/auth/oidc/<name>/callback). Empty: no SSO button.
# TCG_OIDC_PROVIDERS=["home"]
# Each provider is then configured by TCG_OIDC_<NAME>_* variables, <NAME> being the
# name in uppercase with - replaced by _. Example for "home":
#
# Login button label (default: the name).
# TCG_OIDC_HOME_DISPLAY_NAME=Home SSO
# Issuer URL (mandatory), discovered through <issuer>/.well-known/openid-configuration.
# TCG_OIDC_HOME_ISSUER=https://sso.example.com/realms/home
# Confidential client used by the web UI (mandatory) and its secret.
# TCG_OIDC_HOME_CLIENT_ID=tcg-web
# TCG_OIDC_HOME_CLIENT_SECRET=change-me
# Public client (PKCE) used by the Android app. Unset: no SSO in the app.
# TCG_OIDC_HOME_MOBILE_CLIENT_ID=tcg-android
# Requested scopes, JSON list. Authelia also needs "groups". Authentik gives a refresh
# token (to check web sessions again, TCG_SSO_RECHECK_SECONDS) only with "offline_access".
# TCG_OIDC_HOME_SCOPES=["openid","profile","email"]
# Claims holding the username and the groups.
# TCG_OIDC_HOME_USERNAME_CLAIM=preferred_username
# TCG_OIDC_HOME_GROUPS_CLAIM=groups
# Deprecated since 0.26.0: only seeds the Administrators group (Admin > Groups) the
# first time it is created. Its identity provider groups are then edited there: SSO
# users in one of them are administrators, others users, synced on each SSO login.
# Other groups (access to optional modules) are linked to IdP groups the same way.
# TCG_OIDC_HOME_ADMIN_GROUPS=[]
# Only members of these groups may sign in. Empty: everybody the IdP accepts.
# TCG_OIDC_HOME_ALLOWED_GROUPS=[]
# Create an account on first SSO sign-in. Off: only SSO accounts created before sign in.
# TCG_OIDC_HOME_AUTO_CREATE_USERS=true
# Page where users change their password and email at the provider, opened by the
# "Edit my profile" button in Zukan's settings (no button when unset and not guessed). Default: guessed for Keycloak
# (<issuer>/account) and Authentik (/if/user/#/settings); other providers need it.
# TCG_OIDC_HOME_ACCOUNT_URL=https://sso.example.com/realms/home/account

# =====================================================================================
# Worker (catalog, price and image refreshes)
# =====================================================================================

# Administrators set when the worker runs on the Data sync page (every few hours, or at
# set times on chosen days). The values below are the defaults until a schedule is saved
# there.
#
# Hours between catalog refreshes (large downloads, new sets are rare). After an upgrade
# that changes how a game's catalog is stored, that catalog is refreshed at once.
# TCG_CATALOG_INTERVAL_HOURS=168
# Hours between price and owned card image refreshes.
# TCG_SYNC_INTERVAL_HOURS=24
# Hours between refreshes of outdated cards (missed by the last catalog refresh, or with
# missing image or details), fetched again one by one. Opening such a card in the web UI
# also fetches it again (at most once an hour).
# TCG_REFRESH_INTERVAL_HOURS=48
# Games to refresh, as a JSON list (e.g. ["mtg","sorcery"]). Empty: every installed game.
# Game ids: mtg, pokemon, pokemon-asia, pokemon-china, sorcery, lorcana, riftbound,
# yugioh, yugioh-ocg. "pokemon" or "yugioh" listed without the other games of its family
# means all of them (one game before 0.17.0).
# TCG_WORKER_GAMES=[]
# Default time zone of the Data sync page's set times (IANA name).
# TCG_SCHEDULE_TIMEZONE=UTC
# User-Agent sent to card data APIs and SSO providers. Default: Zukan/<server version>.
# TCG_USER_AGENT=Zukan/0.31.0
# GitHub repository whose Android releases (android-vX.Y.Z) the web UI offers for download
# and the app's update check reads. Empty: no download link, no update check.
# TCG_ANDROID_RELEASE_REPO=FoxOps/zukan
# Maintenance page while a catalog refresh slows the server down: when API answers take
# longer than TCG_MAINTENANCE_LATENCY_MS (median over 20 s) during a catalog refresh,
# users get a full maintenance page instead of the web interface (in their last language;
# the API answers them 503) until the data sync is over (no job running for 30 s).
# Administrators keep access, with a notice. Runs started on the Data sync page are run by
# the worker, never by the API. TCG_MAINTENANCE_ENABLED=false turns off only this automatic
# maintenance: administrators can always start and stop it by hand in Admin > Server.
# TCG_MAINTENANCE_ENABLED=true
# TCG_MAINTENANCE_LATENCY_MS=500
# Database connections kept open by each process (API, worker), and extra ones opened
# under load. Lower them on a small host; raise them for many simultaneous users.
# TCG_DB_POOL_SIZE=5
# TCG_DB_MAX_OVERFLOW=5
# Log what the scanner app read (text only, no picture, no user) and what was found,
# to report a card that does not scan. Off by default.
# TCG_SCAN_DEBUG_LOG=false
# Compare the set symbol in the picture the app sends (Android 0.16.0+) with set icons, to
# pick the printing of cards without a printed set code (old Magic frames). On by default.
# TCG_SCAN_SYMBOL_MATCH=true
# Request log line per API call (off in the image; a reverse proxy usually logs them).
# UVICORN_ACCESS_LOG=false
# glibc malloc arenas per process (image default 2): few arenas let the worker give the
# memory of a data sync back. Raise only if many users make the API slow.
# MALLOC_ARENA_MAX=2

# =====================================================================================
# Games
# =====================================================================================

# MTG catalog: all_cards (~400 MB download, translated names needed to scan non-English
# cards) or default_cards (~80 MB, English names only).
# TCG_MTG_CATALOG_BULK=all_cards

# Pokémon is three games, one per publisher and market: Pokémon TCG (international:
# English, French, German, Italian, Spanish, Portuguese), Pokémon TCG Asia (Japanese,
# Korean, Traditional Chinese, Thai, Indonesian) and Pokémon TCG China (Simplified
# Chinese). A set listed in several languages is fetched in full once (English, else
# Japanese, Traditional Chinese, Thai, Indonesian); the others add names and images.
# TCGdex languages of the international game:
# TCG_POKEMON_LANGUAGES=["en","fr","de","it","es","pt"]
# TCGdex languages of the Asia game (~40k cards fetched one by one). Unset: the Asian
# languages of TCG_POKEMON_LANGUAGES (it held both before 0.17.0), else these. TCGdex
# also has "ko" and "zh-cn", nearly empty: Korean and Simplified Chinese come from the
# datasets below.
# TCG_POKEMON_ASIA_LANGUAGES=["ja","zh-tw","th","id"]
# Korean cards (Asia game) from github.com/type-null/PTCG-database (~33 MB per catalog
# sync) and mainland China cards (China game) from github.com/duanxr/PTCG-CHS-Datasets
# (~10 MB; non-commercial use only). false skips them.
# TCG_POKEMON_KOREAN=true
# TCG_POKEMON_CHINESE=true
# Pictures of Japanese printings TCGdex has none for (its newest sets), from the official
# Japanese card search (pokemon-card.com), at most this many requests a day, one a
# second. Its card list is kept under TCG_IMAGE_DIR/cache; the first fill takes a few
# days. false skips it.
# TCG_POKEMON_OFFICIAL_JP=true
# TCG_POKEMON_OFFICIAL_JP_DAILY_REQUESTS=300
# Thai, Indonesian and Traditional Chinese cards from the official Asian card search
# (asia.pokemon-card.com) and Korean cards from Pokémon Korea's (pokemoncard.co.kr), for
# the Asia game: names, numbers and pictures that join the Japanese printings (Korean,
# Traditional Chinese) or make sets of their own (Thai and Indonesian products). At most
# this many requests a day per language, one a second; what was read is kept under
# TCG_IMAGE_DIR/cache, the first fill takes a few days. false skips them.
# TCG_POKEMON_OFFICIAL_ASIA=true
# TCG_POKEMON_OFFICIAL_ASIA_DAILY_REQUESTS=500

# Yu-Gi-Oh! is two games: the TCG (Europe, the Americas, Oceania) and the OCG (Japan and
# Asia). Both read YGOPRODeck and YGOJSON (~57 MB per catalog sync, downloaded once for
# both when they sync within an hour).
# Languages of the TCG game: English, French, German, Italian and Portuguese names from
# YGOPRODeck, Spanish ones from YGOJSON.
# TCG_YUGIOH_LANGUAGES=["en","fr","de","it","pt","es"]
# Languages of the OCG game (~85k printings): Japanese, Korean, Chinese and Asian English
# ("-AE" codes) sets from YGOJSON. Unset: the Asian languages of TCG_YUGIOH_LANGUAGES
# (it held both before 0.17.0) and "en", else these.
# TCG_YUGIOH_OCG_LANGUAGES=["ja","ko","zh-hans","zh-hant","en"]
# Pages of the official Konami card database read a day (one a second) for the Japanese
# and Korean names and printings (OCG game) of cards newer than YGOJSON. Each card is
# read once (kept under TCG_IMAGE_DIR/cache). 0: never.
# TCG_YUGIOH_KONAMI_DAILY_REQUESTS=300

# Disney Lorcana: LorcanaJSON (English, French, German, Italian), no setting.

# =====================================================================================
# API keys
# =====================================================================================

# Tokens of external APIs (card data, prices) that need one. Names follow
#   TCG_APITOKEN_<SOURCE TYPE>_[<CATEGORY>_]<API NAME>
# with SOURCE TYPE GAMES (card data) or PRICES (markets), CATEGORY the game for game
# sources (MTG, PKM, SOR, RFB, YGO, LOR), none for sources covering several games, e.g.
# TCG_APITOKEN_GAMES_MTG_SCRYFALL, TCG_APITOKEN_PRICES_CARDNEXUS. Scryfall, MTGJSON,
# TCGdex, Sorcery, Riftcodex, Riot's card gallery, YGOPRODeck,
# YGOJSON, the Konami database, LorcanaJSON, tcgcsv and Cardmarket files need no key. Without a key, the sources below are skipped.
#
# Riftbound: Riot's content API (official). Needs a key Riot approved for a Riftbound
# product (developer.riotgames.com); development keys are refused. Without one, the
# Riftbound catalog comes from Riftcodex (riftcodex.com). How to get one: https://github.com/FoxOps/zukan/wiki/Supported-games-and-sources.
# TCG_APITOKEN_GAMES_RFB_RIOT=
# Card databases filling what each game's own sources miss (pictures, rarities, artists,
# TCGplayer ids), only for sets with gaps:
# - tcg-api.eu (Pokémon, Magic, Lorcana; 10 000 requests a day on the free tier)
# TCG_APITOKEN_GAMES_TCGAPIEU=
# TCG_TCGAPI_EU_DAILY_REQUESTS=9000
# - apitcg.com (Magic, Pokémon, Riftbound, Yu-Gi-Oh!, Lorcana; 1000 requests a month on
#   the free tier: it runs after every other source and skips sets it found nothing for,
#   30 days)
# TCG_APITOKEN_GAMES_APITCG=
# TCG_APITCG_MONTHLY_REQUESTS=900
#
# CardNexus (cardnexus.com → Settings → API Keys; Magic, Pokémon, Yu-Gi-Oh!, Sorcery,
# Lorcana, Riftbound): daily files of its catalog and prices, one API request per game
# and run, the files kept under TCG_IMAGE_DIR/cache. Adds the CardNexus price source
# (lowest listing, EUR) and Cardmarket / TCGplayer prices no other source has; in the
# catalog job, fills pictures, rarities and market ids and adds printings a set lacks.
# CardNexus has no Pokémon China, Korean, Thai or Indonesian cards (Japanese only, as
# "Pokemon Japan"). Pokémon and Pokémon Asia printings left without a Cardmarket price
# by TCGdex get one from Cardmarket's public price guide file (no key needed); Pokémon China
# printings are paired with Cardmarket products by English card name in the price job.
# TCG_APITOKEN_PRICES_CARDNEXUS=
# TCG_CARDNEXUS_DAILY_REQUESTS=1000

# =====================================================================================
# Set by the compose files and the image: only for running the server outside Docker
# =====================================================================================

# Database (compose builds it: the owner role for `migrate`, zukan_app for the API and
# worker), and the runtime role's name made by `zukan db-roles`.
# TCG_DATABASE_URL=postgresql+asyncpg://tcg:tcg@localhost:5432/tcg
# TCG_DB_APP_USER=zukan_app
# Built web UI, card image cache, and folder card images are imported from
# (image: /app/web, /data/images, /data/import). The image folder holds one folder per
# game: cards/, sets/, symbols/ and rarity/ (own pictograms there replace Zukan's, see
# README "Image folders").
# TCG_WEB_DIR=../web/dist
# TCG_IMAGE_DIR=data/images
# TCG_IMPORT_DIR=data/import
