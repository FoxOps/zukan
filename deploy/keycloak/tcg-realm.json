{
  "realm": "tcg",
  "enabled": true,
  "sslRequired": "none",
  "groups": [
    {
      "name": "tcg-admins"
    },
    {
      "name": "tcg-users"
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@tcg.test",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "TCG",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "groups": [
        "/tcg-admins",
        "/tcg-users"
      ]
    },
    {
      "username": "user",
      "email": "user@tcg.test",
      "emailVerified": true,
      "firstName": "User",
      "lastName": "TCG",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "groups": [
        "/tcg-users"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "tcg-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "tcg-web-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8000/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8000/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "tcg-android",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "fr.fudabako.app:/oauth2redirect"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
